# FieryVoid is a Yarn 1 project. Whenever npm installs, it also rewrites yarn.lock and drops the
# other platforms' binaries from it (one such rewrite went unnoticed in a commit in 2026-06).
# This line plus package.json's "engines": { "npm": "please-use-yarn" } make npm install / ci /
# update / uninstall refuse to run. npm run, and npm install -g yarn, still work.
engine-strict=true
